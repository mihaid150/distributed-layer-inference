# Copy this file to .env for local use. Keep real tokens out of Git.

HF_TOKEN=<hugging-face-read-token>
HF_UPLOAD_TOKEN=<hugging-face-write-token>

# Ops UI native model controller.
# Copy ops-ui/native-models.example.json to ops-ui/native-models.json and edit entries.
OPS_UI_NATIVE_MODELS_FILE=ops-ui/native-models.json
OPS_UI_NATIVE_TOOLS_IMAGE=mipeda150/distributed-layer-inference-native-tools:latest
OPS_UI_NATIVE_CONFIGMAP=dli-native-config

# Optional artifact repo template used when a catalog entry omits artifactRepo.
# Supported placeholder: {slug}
HF_NATIVE_MODEL_ARTIFACT_REPO=your-user-or-org/dli-{slug}-native-gguf

# Optional aliases for local helper scripts or notes.
dli-read-token=<hugging-face-read-token>
dli-upload-token=<hugging-face-write-token>
