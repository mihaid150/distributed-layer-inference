# syntax=docker/dockerfile:1.7
# Pinned to a digest so build cache keys stay stable across runs.
ARG BASE_IMAGE=python:3.11-slim@sha256:a5b427ace4900267d93db34138e512325c6fa6af84ad5e4ed5f3b36258cc4142
FROM ${BASE_IMAGE}
ARG PIP_INDEX_URL=https://pypi.org/simple
ARG PIP_TRUSTED_HOST=pypi.org

WORKDIR /app

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
      curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-gateway.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    PIP_INDEX_URL="${PIP_INDEX_URL}" PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}" \
    pip install -r requirements-gateway.txt

# Copy only runtime packages needed by the gateway process.
COPY src/dli/__init__.py ./src/dli/__init__.py
COPY src/dli/common/ ./src/dli/common/
COPY src/dli/feature_modules/ ./src/dli/feature_modules/
COPY src/dli/inference_gateway/ ./src/dli/inference_gateway/
# Gateway generation uses the shared activation codec module.
COPY src/dli/inference_stage/__init__.py ./src/dli/inference_stage/__init__.py
COPY src/dli/inference_stage/activation_codec.py ./src/dli/inference_stage/activation_codec.py
COPY src/dli/stage_runtimes/__init__.py ./src/dli/stage_runtimes/__init__.py
COPY src/dli/stage_runtimes/python_legacy/__init__.py ./src/dli/stage_runtimes/python_legacy/__init__.py
COPY src/dli/stage_runtimes/python_legacy/activation_codec.py ./src/dli/stage_runtimes/python_legacy/activation_codec.py

COPY configs/ ./configs/

ENV PYTHONPATH=/app/src

CMD ["uvicorn", "dli.inference_gateway.app:app", "--host", "0.0.0.0", "--port", "8000"]
